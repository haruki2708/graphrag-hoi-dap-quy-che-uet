# Copy this file to .env and fill in the values. Never commit .env.

# Bolt address used by the Python scripts, e.g. bolt://localhost:7687
NEO4J_URI=
# Neo4j Community only allows the initial username: neo4j
NEO4J_USER=
# Password, at least 8 characters
NEO4J_PASSWORD=

# Anthropic API key (answer generation, KG extraction), from platform.claude.com
ANTHROPIC_API_KEY=
# Gemini API key (judge fallback, free tier), from aistudio.google.com
GEMINI_API_KEY=
# HuggingFace cache for embedding models (~5 GB for the two compared models). Keep it off drive C:,
# outside the repo, e.g. D:\hf_cache. Read by src/retrieval/dense.py before any HuggingFace import.
HF_HOME=
# NVIDIA NIM API key (judge (decision #2), OpenAI-compatible endpoint), from build.nvidia.com
NVIDIA_API_KEY=
