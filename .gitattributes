# Question sets are locked by sha256 (docs/weekly/w2.md): keep their bytes exactly as committed
# (LF line endings, no CRLF conversion on checkout with core.autocrlf=true).
data/eval/*.jsonl -text

# data/processed: qc3626.json keeps its CRLF bytes as committed, because its sha256 is recorded in
# meta.sources of qc3626_graph.json. The files generated by scripts are pinned to LF.
data/processed/qc3626.json -text
data/processed/qc3626_graph.json text eol=lf
data/processed/*.jsonl text eol=lf
# Semantic-layer extraction records and triplet CSVs (src/kg/extract.py, export_triplets.py) are written with LF.
data/processed/semantic/** eol=lf
